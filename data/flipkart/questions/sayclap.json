 "type": "code",
 "ref": "class Solution:\n    def sayOrClap(self, n: int, actions: str) -> List[List[int]]:\n        corr = ['C' if (i + 1) % 3 == 0 or '3' in str(i + 1) else 'S' for i in range(len(actions))]\n        alive = list(range(1, n + 1)); out = []\n        while len(alive) > 1:\n            elim = None\n            for i, ch in enumerate(actions):\n                if ch != corr[i]: elim = alive[i % len(alive)]; break\n            if elim is None: break\n            alive.remove(elim); out.append(elim)\n        return [out if out else [-1], alive]\n",
 "refcpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){ int n; string s; cin>>n>>s; int m=s.size();\n  // simulate with a linked list of alive players instead of erasing from a vector\n  vector<int> alive; for(int i=1;i<=n;i++) alive.push_back(i); vector<int> out;\n  auto correct=[](int x){ return (x%3==0 || to_string(x).find('3')!=string::npos) ? 'C' : 'S'; };\n  int first=-1; for(int i=0;i<m;i++) if(s[i]!=correct(i+1)){first=i;break;}   // the first wrong index never changes\n  while((int)alive.size()>1 && first>=0){ int k=first%alive.size(); out.push_back(alive[k]); alive.erase(alive.begin()+k); }\n  if(out.empty()) cout<<-1; else for(size_t i=0;i<out.size();i++) cout<<out[i]<<(i+1<out.size()?\" \":\"\");\n  cout<<\"\\n\"; for(size_t i=0;i<alive.size();i++) cout<<alive[i]<<(i+1<alive.size()?\" \":\"\"); cout<<\"\\n\"; }\n",
