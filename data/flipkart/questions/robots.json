 "type": "code",
 "ref": "class Solution:\n    def maxGoods(self, grid: List[List[int]]) -> int:\n        R, C = len(grid), len(grid[0]); g = grid\n        NEG = -1; dp = [[NEG] * C for _ in range(C)]; dp[0][C - 1] = g[0][0] + (g[0][C - 1] if C > 1 else 0)\n        for r in range(1, R):\n            nd = [[NEG] * C for _ in range(C)]\n            for a in range(C):\n                for b in range(C):\n                    if dp[a][b] < 0: continue\n                    for na in (a - 1, a, a + 1):\n                        if not 0 <= na < C: continue\n                        for nb in (b - 1, b, b + 1):\n                            if not 0 <= nb < C: continue\n                            v = dp[a][b] + g[r][na] + (g[r][nb] if na != nb else 0)\n                            if v > nd[na][nb]: nd[na][nb] = v\n            dp = nd\n        return max(max(x) for x in dp)\n",
 "refcpp": "#include <bits/stdc++.h>\nusing namespace std;\nint R,C,g[50][50],memo[50][50][50];\nint go(int r,int a,int b){ if(a<0||b<0||a>=C||b>=C) return INT_MIN/2; int v=g[r][a]+(a!=b?g[r][b]:0); if(r==R-1) return v;\n  int &m=memo[r][a][b]; if(m>=0) return m; int best=INT_MIN/2; for(int i=-1;i<=1;i++) for(int j=-1;j<=1;j++) best=max(best,go(r+1,a+i,b+j)); return m=v+best; }\nint main(){ cin>>R>>C; for(int i=0;i<R;i++) for(int j=0;j<C;j++) cin>>g[i][j]; memset(memo,-1,sizeof memo); cout<<go(0,0,C-1)<<\"\\n\"; }\n",
